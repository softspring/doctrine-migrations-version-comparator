{
    "name": "softspring/doctrine-migrations-version-comparator",
    "description": "Provides a class to sort doctrine migrations by version name",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^2.6 || ^3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^1.9 || ^2.0",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\DoctrineMigrationsVersionComparator\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
